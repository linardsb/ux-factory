# dependencies / build
node_modules/
dist/

# cloudflare / wrangler
.wrangler/
.dev.vars

# os / editor
.DS_Store
*.log

# portal (local workbench — secrets + runtime state)
portal/.env
portal/.sessions.json

# repo-root secrets (.claude/mcp-posthog-headers.sh reads POSTHOG_API_KEY from here)
.env

# figma parity (raw API dumps + their manifest — neither artifact nor proof)
tooling/figma/.last-response.json
tooling/figma/.raw/

# figma imports (a dropped export is someone else's design file — the pack is the artifact)
tooling/figma/exports/

# the PR loop's per-run gate record — a stamp of one run on one machine, not an
# artifact. The rest of .claude/ (plans, reports, reviews) IS committed, deliberately.
.claude/last-gate.json
